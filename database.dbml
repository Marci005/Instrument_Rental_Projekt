table users {
  user_id int [pk, increment]
  is_admin bool
  email varchar(100) [unique]
  pass varchar(255) [not null]
  title enum('Uram', 'Hölgyem', 'Dr', 'Professzor')
  first_name varchar(100)
  last_name varchar(100)
  created date
  updated date
}

table addresses {
  address_id int [pk, increment]
  user_id int [not null]
  address_type enum('szállítási', 'szálázási', 'szállítási és számlázási')
  zip int [not null]
  settlement varchar(100) [not null]
  street varchar(100) [not null]
  street_type enum('út', 'utca', 'tér', 'köz', 'körút') [not null]
  house_number varchar(20) [not null]
  floor_number smallint
  door_number smallint
  created date
  updated date
}

table instrument_categories {
  category_id int [pk, increment]
  category_name varchar(100) [not null]
  category_desc text
  created date
  updated date
}

table instrument_brands {
  brand_id int [pk, increment]
  brand_name varchar(100) [not null]
  brand_desc text
  created date
  updated date
}

table instruments {
  instrument_id int [pk, increment]
  category_id int
  brand_id int
  condition enum('új', 'újszerű', 'használt', 'megkímélt') [not null]
  title varchar(100) [not null]
  description text [not null]
  created date
  updated date
}

table rents {
  rent_id int [pk, increment]
  user_id int
  instrument_id int
  rent_price int
  start_date datetime
  end_date datetime
  real_end_date datetime
  created datetime
  updated datetime
}

Ref: "users"."user_id" < "addresses"."user_id"

Ref: "instrument_categories"."category_id" < "instruments"."category_id"

Ref: "instrument_brands"."brand_id" < "instruments"."brand_id"


Ref: "instruments"."instrument_id" < "rents"."instrument_id"

Ref: "users"."user_id" < "rents"."user_id"